{
  "name": "catalog-note-map",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "docker:stop": "docker rm -f map || true",
    "docker:start": "docker build -t catalog-note-map --build-arg COMMIT=$(git rev-parse --short HEAD) . && docker run -d -p 8080:8080 --name map catalog-note-map",
    "tunnel": "docker run --rm cloudflare/cloudflared:latest tunnel --url http://host.docker.internal:8080",
    "share": "npm run docker:stop && npm run docker:start && npm run tunnel"
  },
  "dependencies": {
    "express": "4.21.2"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "22.10.2",
    "@types/supertest": "6.0.2",
    "@vitest/coverage-v8": "2.1.8",
    "supertest": "7.0.0",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
